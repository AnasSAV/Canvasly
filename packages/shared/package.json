{
  "name": "@canvasly/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Schemas, geometry, Yjs helpers, permissions and templates for Canvasly, a real-time collaborative whiteboard",
  "license": "MIT",
  "author": "Anas Hussaindeen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnasSAV/Canvasly.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/AnasSAV/Canvasly/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/AnasSAV/Canvasly/issues"
  },
  "keywords": [
    "whiteboard",
