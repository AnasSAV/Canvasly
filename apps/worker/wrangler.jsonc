{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvasly",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth uses AsyncLocalStorage and a few node: built-ins.
  "compatibility_flags": ["nodejs_compat"],

  // Served only on the custom domain (the zone is on Cloudflare, which creates the DNS record and TLS
  // certificate on deploy). One canonical origin keeps auth cookies and same-origin checks simple.
  "routes": [{ "pattern": "canvasly.anas-hussaindeen.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Public origin used by Better Auth and the same-origin guard. .dev.vars overrides it locally.
  // EMAIL_FROM must be on a domain verified in Resend (RESEND_API_KEY is a secret).
  "vars": {
    "BETTER_AUTH_URL": "https://canvasly.anas-hussaindeen.com",
    "EMAIL_FROM": "Canvasly <noreply@canvasly.anas-hussaindeen.com>",
  },

  // The SPA is served as static assets (free, not counted as Worker requests). Only /api/* runs the Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canvasly",
      // From `wrangler d1 create canvasly`. Local dev uses a local SQLite copy instead.
      "database_id": "36cd1fe1-1d19-463f-ad89-aab85ea1ecc4",
      "migrations_dir": "migrations",
    },
  ],

  // One Durable Object per board. The Free plan only supports SQLite-backed Durable Objects.
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],

  "observability": { "enabled": true },
}
