{
  "name": "@canvasly/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Canvasly API: Cloudflare Worker, Better Auth and the BoardRoom Durable Object",
  "license": "MIT",
  "author": "Anas Hussaindeen",
  "homepage": "https://canvasly.anas-hussaindeen.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnasSAV/Canvasly.git",
    "directory": "apps/worker"
  },
  "bugs": {
    "url": "https://github.com/AnasSAV/Canvasly/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/predev.mjs && pnpm db:migrate:local",
    "dev": "wrangler dev --port 8787 --infer-origin-from-routes=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types --include-runtime=false",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@canvasly/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "hono": "^4.13.14",
    "lib0": "^0.2.119",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.156.0"
  }
}
