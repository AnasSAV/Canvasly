# Copy to .dev.vars for local development (never commit .dev.vars).
# Any long random string; production uses `wrangler secret put BETTER_AUTH_SECRET`.
BETTER_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
# Origin the browser uses. In dev that's the Vite server, which proxies /api to wrangler.
BETTER_AUTH_URL=http://localhost:5173
# Optional: enables "Continue with Google". Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: send real email through Resend (otherwise emails are printed to the wrangler log and
# email verification stays off). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Canvasly <onboarding@resend.dev>
