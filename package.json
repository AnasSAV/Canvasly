{
  "name": "canvasly",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time collaborative whiteboard that runs entirely on Cloudflare Workers Free",
  "license": "MIT",
  "author": "Anas Hussaindeen",
  "homepage": "https://canvasly.anas-hussaindeen.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnasSAV/Canvasly.git"
  },
  "bugs": {
    "url": "https://github.com/AnasSAV/Canvasly/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,magenta \"pnpm --filter @canvasly/worker dev\" \"pnpm --filter @canvasly/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:deploy": "pnpm --filter @canvasly/web build && pnpm --filter @canvasly/worker exec wrangler deploy",
    "db:migrate:local": "pnpm --filter @canvasly/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @canvasly/worker db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
